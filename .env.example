# ==============================================================================
# CricPulse Developer Portal - Environment Configuration Template
# Copy this file to .env and configure your local or production values.
# ==============================================================================

# Django Core & Security Settings
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,yourcustomdomain.com

# CricPulse Analytical Engine URL (FastAPI Backend)
CRICPULSE_ENGINE_URL=https://cricpulse-engine.onrender.com

# Internal Microservice Shared Secret (FastAPI <-> Django Key Sync)
INTERNAL_SERVICE_SECRET=generate-a-secure-random-service-secret-token

# Administrator Superuser Credentials
DJANGO_SUPERUSER_USERNAME=cricpulse@admin.com
DJANGO_SUPERUSER_EMAIL=kmohdhamza10@gmail.com
DJANGO_SUPERUSER_PASSWORD=change-to-a-strong-production-admin-password

# Master Admin Enterprise API Key (Tier: Enterprise • 1200 req/min)
MASTER_ADMIN_API_KEY=cric_live_your_master_admin_api_key_here

# PostgreSQL Database Connection String (Render sets this automatically)
# DATABASE_URL=postgresql://cricpulse_user:password@host:5432/cricpulse_portal_db
